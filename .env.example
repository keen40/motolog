# Host port (loopback only) that `tailscale serve` proxies to
MOTOLOG_PORT=3010
# tailscale (default) | header (SSO forward-auth, e.g. Authentik) | dev
AUTH_MODE=tailscale
# Only for AUTH_MODE=header:
# AUTH_EMAIL_HEADER=x-authentik-email
# AUTH_NAME_HEADER=x-authentik-name

# AI catalogue lookups (optional). Without a key the lookup form is disabled.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-6-luna        # cheapest; gpt-6.2-sol if results are poor
# AI_MONTHLY_LOOKUPS=20          # hard cap per calendar month (~$0.10–0.15 per lookup on luna)
# AI_MAX_SEARCHES=12             # web searches per lookup ($0.01 each)

# --- local development (npm run dev) ---
# DATA_DIR=./data
# DEV_USER_EMAIL=me@dev.local
